# MoonTV 配置示例 | MoonTV Configuration Example
# 复制此文件为 .env 并修改为你的配置
# Copy this file to .env and modify with your settings

# MoonTV 网关地址（返回可用 CMS 源站列表）
# MoonTV Gateway URL (returns available CMS source list)
MOONTV_GATEWAY=https://moontv-api.12879737.xyz

# MoonTV 播放页地址（用于生成播放链接）
# MoonTV Play URL (for generating playback links)
MOONTV_PLAY_URL=https://moontv.dduan2002cn.xyz/play

# 追剧配置文件路径
# Watchlist configuration file path
WATCHLIST_FILE=config/watchlist.json
